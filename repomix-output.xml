<file path="WebApi/Controllers/StorageTestController.cs">
using core.Interfaces;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace WebApi.Controllers
{
    // GEÇİCİ: Depolama testi için. Test bitince silinecek.
    [Route("api/[controller]")]
    [ApiController]
    [Authorize]
    public class StorageTestController : ControllerBase
    {
        private readonly IFileStorage _storage;

        public StorageTestController(IFileStorage storage)
        {
            _storage = storage;
        }

        [HttpPost]
        public async Task<IActionResult> Upload(IFormFile file)
        {
            if (file == null || file.Length == 0)
            {
                return BadRequest(new { message = "Dosya seçilmedi." });
            }

            try
            {
                await using var stream = file.OpenReadStream();
                var extension = Path.GetExtension(file.FileName);
                var key = await _storage.SaveAsync(
                    stream, extension, file.ContentType, "tests");

                return Ok(new { key });
            }
            catch (Exception ex)
            {
                return BadRequest(new { message = ex.Message });
            }
        }

        [HttpGet]
        public async Task<IActionResult> Download([FromQuery] string key)
        {
            try
            {
                var stream = await _storage.OpenReadAsync(key);
                return File(stream, "application/octet-stream");
            }
            catch (FileNotFoundException)
            {
                return NotFound(new { message = "Dosya bulunamadı." });
            }
            catch (Exception ex)
            {
                return BadRequest(new { message = ex.Message });
            }
        }

        [HttpDelete]
        public async Task<IActionResult> Delete([FromQuery] string key)
        {
            try
            {
                await _storage.DeleteAsync(key);
                return NoContent();
            }
            catch (Exception ex)
            {
                return BadRequest(new { message = ex.Message });
            }
        }
    }
}
